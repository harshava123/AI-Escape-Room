# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Never commit the .env file.

# Google Gemini API key - get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model for parsing and narration (any text model available to your key).
# Flash-Lite is fast and has a much larger free-tier daily quota than Flash
# (Flash can be as low as 20 requests/day on the free tier).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: a different model just for designing rooms (one request per level).
# Quotas are per model, so this spreads usage. Leave empty to use GEMINI_MODEL.
# GEMINI_ROOM_MODEL=gemini-3.5-flash

# Port for the local web server
PORT=3000
